---
import { getCollection, render } from 'astro:content'
import ArticleItem from '../components/ArticleItem.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const articles = await Promise.all(
  (await getCollection('articles')).map(async (article) => {
    const { remarkPluginFrontmatter } = await render(article)
    return { ...article, minutesRead: remarkPluginFrontmatter.minutesRead }
  }),
).then((collection) =>
  collection.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  ),
)
---

<BaseLayout>
  <main class="mx-auto w-11/12 py-12 md:w-xl">
    <h2 class="text-sm font-semibold sm:text-lg">Writing</h2>
    <div class="mt-4 flex flex-col gap-10">
      {
        articles.map((article) => (
          <a href={`/articles/${article.id}`}>
            <ArticleItem
              title={article.data.title}
              description={article.data.description}
              pubDate={article.data.pubDate}
              minutesRead={article.minutesRead}
            />
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>
