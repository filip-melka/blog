---
const { title, description, pubDate, minutesRead } = Astro.props

const formattedPubDate = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
---

<div>
  <p class="text-lg sm:text-xl md:text-2xl">{title}</p>
  <p class="my-2 text-sm sm:text-base">
    {description}
  </p>
  <div class="text-text/70 flex gap-8 text-xs sm:text-sm">
    <span>{formattedPubDate}</span>
    <span>{minutesRead}</span>
  </div>
</div>
