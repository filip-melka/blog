---
import { Rss } from '@lucide/astro'
import ThemeToggle from './ThemeToggle.astro'
---

<header>
  <nav
    class="mx-auto flex h-20 w-11/12 items-center justify-between md:w-full md:px-[10%]"
  >
    <a href="/"> <h1 class="font-semibold">Filip's Blog</h1></a>
    <div class="flex items-center gap-2 md:gap-4">
      <a href="/rss.xml" aria-label="RSS feed" class="p-1">
        <Rss size={20} />
      </a>
      <ThemeToggle />
    </div>
  </nav>
</header>
